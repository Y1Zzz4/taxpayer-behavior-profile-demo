# OpenAI-compatible API configuration. Replace every value locally.
LLM_BASE_URL=https://example.invalid/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-model-name

# Phone protection secrets. Never commit real values.
PHONE_HASH_KEY=replace-with-a-long-random-secret
PHONE_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

# Optional local output location.
DATABASE_PATH=data/database/taxpayer_profiles.sqlite3
